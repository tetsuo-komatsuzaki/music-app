generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  processing
  done
  error
  queued
  retrying
}

model User {
  id             String        @id @default(cuid())
  supabaseUserId String        @unique
  name           String
  role           Role          @default(student)
  plan           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  performances   Performance[]
  scores         Score[]

  // ▼ 練習メニュー追加分
  practiceItems        PracticeItem[]
  practicePerformances PracticePerformance[]
  weaknesses           UserWeakness[]

  // ▼ S-1: アカウント設定追加分
  aiTrainingOptIn          Boolean          @default(false)
  aiTrainingOptInChangedAt DateTime?
  deletedAt                DateTime? // 退会受付時刻 (idempotency key 兼用)
  feedbacks                Feedback[]
  supportInquiries         SupportInquiry[]

  // ▼ v3.2.2 上達ループエンジン (Commit 1)
  userSkillScores           UserSkillScore[]
  userSkillSubScores        UserSkillSubScore[]
  userSkillTaskCards        UserSkillTaskCard[]
  userGrade                 UserGrade?
  performanceSkillFeedbacks PerformanceSkillFeedback[]

  // ▼ v1.3 上達ループエンジン拡張 (R3 = C ハイブリッド構造)
  songMasteries          SongMastery[]
  userGradeProgress      UserGradeProgress?
  skillTaskCards         SkillTaskCard[]
  userPracticeMasteries  UserPracticeMastery[]
  userTechniqueMasteries UserTechniqueMastery[]

  // ▼ 工程D (2026-07-11): 新判定体系（達成/マスター/Star/学びレッスン）
  lessonClears         UserLessonClear[]
  scoreAchievements    UserScoreAchievement[]
  practiceAchievements UserPracticeAchievement[]
  starProgress         UserStarProgress?

  // ▼ オンボーディング C5 (2026-07-12)
  // 診断予約: 元用途(初回演奏時に診断)は工程Cで常時診断化され充足済み。
  // 現在の意味 = 初回演奏時に仮習得(UserTagAcquisition)を検証する予約。
  diagnosisReservedAt DateTime?
  onboardingProfile   OnboardingProfile?
  tagAcquisitions     UserTagAcquisition[]
  songRequests        SongRequest[]
  lessonPlays         UserLessonPlay[]

  // ▼ お気に入り (2026-07-20): 曲(Score)/教材(PracticeItem) をブックマーク
  favorites Favorite[]

  // ▼ 先生ユーザー機能 MVP (2026-07-28): 先生⇄生徒リンク + 宿題。別シェル /teacher。
  teacherInviteCode   String?          @unique // 先生が発行する招待コード。生徒が入力して紐付け
  teacherLinks        TeacherStudent[] @relation("teacherLinks") // 自分が先生として持つ生徒
  studentLinks        TeacherStudent[] @relation("studentLinks") // 自分が生徒として持つ先生
  assignmentsGiven    Assignment[]     @relation("assignmentTeacher")
  assignmentsReceived Assignment[]     @relation("assignmentStudent")
  messagesAsTeacher   Message[]        @relation("msgTeacher")
  messagesAsStudent   Message[]        @relation("msgStudent")
  feedbacksAsTeacher  TeacherFeedback[] @relation("fbTeacher")
  feedbacksAsStudent  TeacherFeedback[] @relation("fbStudent")
  teacherProfile      TeacherProfile?   @relation("profileTeacher")

  @@index([role])
}

model Score {
  id               String         @id @default(cuid())
  createdById      String
  title            String
  composer         String?
  originalXmlPath  String
  generatedXmlPath String?
  coverImagePath   String? // AI生成カバー画像(Supabase Storage public URL)。無ければUI側でプレースホルダ
  genre            String? // 曲ジャンル (songGenre.ts: warabe/shouka/classic/folk/pops)。既存はAI分類、新規はadmin手動
  // ▼ 教材グループ・変種 (2026-07-18): Score = 曲の変種。難易度別アレンジ + 練習範囲。
  groupId          String? // MaterialGroup。backfill で 1:1 付与
  group            MaterialGroup? @relation(fields: [groupId], references: [id])
  difficulty       Difficulty? // 難易度別アレンジ (BEGINNER/INTERMEDIATE/ADVANCED)
  sections         Json? // 練習範囲 [{name,startMeasure,endMeasure}]
  analysisStatus   JobStatus      @default(processing)
  buildStatus      JobStatus      @default(processing)
  retryCount       Int            @default(0)
  errorMessage     String?
  lastAttemptedAt  DateTime?
  executionId      String?
  idempotencyKey   String?        @unique
  keyTonic         String?
  keyMode          String?
  timeNumerator    Int?
  timeDenominator  Int?
  defaultTempo     Int?
  isShared         Boolean        @default(false) // true=全ユーザー閲覧可のサンプル

  // ループエンジン用フィールド (2026-05-10 追加 / v1.3 で difficulty → star リネーム)
  // 「次のチャレンジ」レコメンドで Score も対象とするため、
  // PracticeItem と同形のメタデータを Score にも持たせる。
  star             Int? // 1〜10、グレード範囲フィルタ用 (旧名 difficulty)
  skillSubTaskTags Json? // sub_task ID 配列、レコメンド対象判定用

  // ▼ v1.3 上達ループエンジン拡張 (R4 = D 確定)
  // ownerScope = "admin" の Score のみがループエンジンの対象。
  // R4 = D により既存 Score 全件 "admin" にマイグレーション。
  // 将来ユーザーアップロード機能を有効化するときは "user" を発行する。
  ownerScope String @default("admin")

  // ▼ 工程F: 特徴タグ・数値系カラム (2026-07-10, 設計書§14/§19-1)
  pitchMin  Int? // 音域下限 (MIDI)。analyze_musicxml 層1拡張(工程A)で投入
  pitchMax  Int? // 音域上限 (MIDI)
  positions Int[] @default([]) // 音高的に必要なポジション構成(推定) §19-1

  createdAt    DateTime      @default(now())
  deletedAt    DateTime? // 論理削除フラグ (NULL=有効、値あり=削除済み)
  performances Performance[]

  // ▼ v1.3 上達ループエンジン (back-references)
  songMasteries            SongMastery[]
  skillTaskCards           SkillTaskCard[]
  missingPracticeItemFlags MissingPracticeItemFlag[]

  // ▼ 工程D (2026-07-11): 曲の達成/マスター記録
  userScoreAchievements UserScoreAchievement[]
  scoreTechniqueTags    ScoreTechniqueTag[] // Phase 3c (Q4=B): 完全習得判定の技法集合

  // ▼ 工程F (2026-07-10): 特徴タグ・副次調
  scoreKeys   ScoreKey[] // 副次調(転調先)。主調は keyTonic/keyMode が正
  featureTags ScoreFeatureTag[]

  // ▼ オンボーディング目標曲カタログとの結線 (2026-07-12)
  onboardingSongs OnboardingSong[]

  // ▼ お気に入り (2026-07-20)
  favorites   Favorite[]
  assignments Assignment[] // 先生機能: この曲を対象にした宿題

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([isShared])
  @@index([ownerScope])
}

model Performance {
  id                   String            @id @default(cuid())
  performanceType      PerformanceType
  performanceStatus    PerformanceStatus @default(uploaded)
  userId               String
  scoreId              String
  name                 String? // 表示名 (例: "Performance #3")。null = 旧データ
  audioPath            String
  audioFeaturesPath    String?
  comparisonResultPath String?
  pseudoXmlPath        String?
  performanceDuration  Float?
  performanceDate      DateTime?
  uploadedAt           DateTime          @default(now())
  createdAt            DateTime          @default(now())
  score                Score             @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ▼ 解析結果サマリー（段階3: ハイブリッド方式）
  pitchAccuracy   Float? // 0-100 ピッチ正確率（頻繁表示 → カラム）
  timingAccuracy  Float? // 0-100 タイミング正確率（頻繁表示 → カラム）
  overallScore    Float? // 0-100 総合スコア（v1.0 旧式: pitch×0.6 + timing×0.4 / v1.3 で計算式変更予定: (pitch + rhythm + bowing) / 3）
  evaluatedNotes  Int? // 評価対象ノート数
  analysisSummary Json? // 将来の拡張用（ビブラート・弓使い・音色等）

  // ▼ 区間録音（部分練習 Phase 2, 2026-07-18）: 選択区間だけを録音・部分採点した演奏。
  // null = 通常の全体演奏。非null = 区間演奏 → 曲の公式スコア/マスター判定には非算入（練習補助）。
  // note_index ベース（analysis.notes のインデックス）。
  rangeFromNote Int?
  rangeToNote   Int?

  // ▼ パート分け (2026-07-26): この区間録音がどのパート(MaterialGroup.parts[].id)か。
  // null = 通常/自由区間。非null = 名前付きパートの練習 → パート別の自己ベスト/推移の集計キー。
  partId String?

  // ▼ v1.3 上達ループエンジン拡張 (R1 = B: pitch/rhythm/bowing 体系)
  // 旧 timingAccuracy は Phase 2 で rhythmAccuracy にリネーム予定 (案 Y)。
  // 移行期間中は両カラムを併存 (timingAccuracy は legacy、rhythmAccuracy が正)。
  rhythmAccuracy Float? // 0-100 リズム正確率
  bowingAccuracy Float? // 0-100 ボウイング正確率 (弦移動・スラー・強弱変化)

  // ▼ v1.3 上達ループエンジン: PracticePerformance ミラー
  // (score_full のループエンジン処理を Score 演奏でも実行可能にする)
  pitchSkillScore      Float?
  rhythmSkillScore     Float?
  bowingSkillScore     Float?
  skillSubScores       Json? // 9 sub task の結果 (各 score, target_count, matched 等)
  problematicPositions Json? // 「気になる箇所」配列

  // ▼ 非同期ジョブライフサイクル（Cloud Run Jobs）
  analysisStatus  JobStatus @default(done)
  retryCount      Int       @default(0)
  errorMessage    String?
  lastAttemptedAt DateTime?
  executionId     String?
  idempotencyKey  String?   @unique

  // ▼ v1.3 上達ループエンジン (back-references)
  skillFeedbacks PerformanceSkillFeedback[]

  @@index([scoreId])
  @@index([userId, uploadedAt])
  // achievement-status / score-performances が userId+scoreId で絞り uploadedAt で並べる hot path 用
  @@index([userId, scoreId, uploadedAt])
}

// 譜面注釈（Phase 1, 2026-07-19）: ユーザーが譜面に付けるハイライト/テキスト/注意メモ/記譜スタンプ。
// 音符アンカー(note_index)で保持し、OSMD再レイアウトに追従。1ユーザー×1教材で1レコード(data JSON)。
// data = { highlight:[{fromNote,toNote,color}], warnings:[{noteIndex,dy,kind,text}], notation:[{noteIndex,kind,value}] }
model ScoreAnnotation {
  id             String   @id @default(cuid())
  userId         String
  scoreId        String? // 曲の場合
  practiceItemId String? // 練習アイテムの場合
  data           Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, scoreId])
  @@unique([userId, practiceItemId])
  @@index([userId])
}

enum Role {
  student
  teacher
  admin
}

enum PerformanceType {
  user
  pro
}

enum PerformanceStatus {
  uploaded
  invalid
  deleted
}

// =============================================
// ▼ 練習メニュー機能
// =============================================

enum PracticeCategory {
  scale
  arpeggio
  etude
  // 2026-05-31 練習メニュー再編: 基礎練の新カテゴリ追加
  fingering
  bowing
  position_shift
  double_stop
  // 工程D (2026-07-11): 学びレッスン = 教材パイプライン全再利用の新カテゴリ。
  // 「教えるタグ」は教材自身のタグ(TechniqueTag/FeatureTag/positions)で表現。
  lesson
}

// ▼ 教材グループ・変種モデル (2026-07-18 Tetsuo確定、設計書 §material-group)
// 一覧の単位=MaterialGroup。配下の変種(Score/PracticeItem)が軸違いでぶら下がる。
enum MaterialKind {
  SONG
  ETUDE
  SCALE
  ARPEGGIO
  FINGERING
  BOWING
  POSITION_SHIFT
  DOUBLE_STOP
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// 一覧・カバーの単位。1グループ配下は Score のみ or PracticeItem のみ (混在しない)。
model MaterialGroup {
  id             String         @id @default(cuid())
  kind           MaterialKind
  category       String // "score" / scale / arpeggio / etude ... (一覧の区分に流用)
  title          String
  composer       String?
  genre          String? // 曲のみ (songGenre.ts の id)
  coverImagePath String? // カバーはグループ単位に集約 (ファイル単位から移行)
  sortOrder      Int            @default(0)
  // ▼ パート分け (2026-07-26): 曲の「◯小節〜◯小節=Part」の範囲リスト(難易度共通・任意個・任意スポット)。
  // [{ id, name, startMeasure, endMeasure, order }]。null=分割なし(通しのみ)。詳細=materialParts.ts
  parts          Json?
  scores         Score[]
  practiceItems  PracticeItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([kind, category])
}

model PracticeItem {
  id               String           @id @default(cuid())
  category         PracticeCategory
  title            String
  composer         String?
  description      String?
  descriptionShort String?
  coverImagePath   String? // AI生成カバー画像(Supabase Storage public URL)。無ければUI側でプレースホルダ

  // ▼ 教材グループ・変種 (2026-07-18): PracticeItem = エチュード/基礎練の変種。
  // エチュード=難易度+範囲 / 基礎練=調(keyTonic)+奏法(articulation)。
  groupId      String? // MaterialGroup。backfill で 1:1 付与
  group        MaterialGroup? @relation(fields: [groupId], references: [id])
  difficulty   Difficulty? // エチュードの難易度
  articulation String? // 基礎練の奏法 (legato/staccato/martele/slur ...)
  sections     Json? // エチュードの分割 [{name,startMeasure,endMeasure}]

  keyTonic   String
  keyMode    String
  tempoMin   Int?
  tempoMax   Int?
  positions  String[] // "1st"形式。工程A(自動抽出)で Int[] へ移行予定
  instrument String   @default("violin")

  // ▼ 工程F: 音域 (2026-07-10, 設計書§19-1)
  pitchMin Int? // MIDI。工程Aで投入
  pitchMax Int?

  originalXmlPath  String
  generatedXmlPath String?
  analysisPath     String?
  analysisStatus   JobStatus @default(processing)
  buildStatus      JobStatus @default(processing)
  retryCount       Int       @default(0)
  errorMessage     String?
  lastAttemptedAt  DateTime?
  executionId      String?
  idempotencyKey   String?   @unique

  ownerUserId String? // null=運営サンプル（全員閲覧可）, 値あり=そのユーザーのみ
  owner       User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  source      String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  metadata    Json? // ▼ 追加
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ▼ v3.2.2 上達ループエンジン (Commit 1、致命1: star は Commit 1.5 で backfill / v1.3 で difficulty → star)
  star             Int? // 1〜10、Commit 1.5 で backfill 後は NOT NULL 化検討 (旧名 difficulty)
  skillSubTaskTags Json? // 9 sub task のタグ配列 (例: ["pitch_overall", "string_change_volume"])
  // C7: PracticeItemTechnique とは独立した別系統 (Commit 8 で初期付与)

  techniques           PracticeItemTechnique[]
  practicePerformances PracticePerformance[]

  // ▼ v1.3 上達ループエンジン (back-references)
  subTaskAssignments      SubTaskAssignment[]
  userPracticeMasteries   UserPracticeMastery[]
  practiceItemSubTaskTags PracticeItemSubTaskTag[]

  // ▼ 工程D (2026-07-11): 教材達成記録
  userPracticeAchievements UserPracticeAchievement[]

  // ▼ 工程F (2026-07-10): 特徴タグ
  featureTags PracticeItemFeatureTag[]

  // ▼ 学びレッスン (2026-07-14): 演奏回数記録
  lessonPlays UserLessonPlay[]

  // ▼ お気に入り (2026-07-20)
  favorites   Favorite[]
  assignments Assignment[] // 先生機能: この教材を対象にした宿題

  @@index([category, keyTonic, keyMode])
  @@index([category, isPublished, sortOrder])
  @@index([ownerUserId])
  @@index([category, star]) // v3.2.2: 教材レコメンド用 (Commit 4) / v1.3: difficulty → star rename
}

model TechniqueTag {
  id              String   @id @default(cuid())
  category        String
  name            String
  nameEn          String?
  description     String?
  xmlTags         String[]
  isAnalyzable    String
  implementStatus String

  practiceItems PracticeItemTechnique[]
  weaknesses    UserWeakness[]

  // ▼ v1.3 上達ループエンジン (back-references)
  userTechniqueMasteries   UserTechniqueMastery[]
  missingPracticeItemFlags MissingPracticeItemFlag[]
  scoreTechniqueTags       ScoreTechniqueTag[] // Phase 3c (Q4=B)

  @@unique([category, name])
  @@index([category])
}

model PracticeItemTechnique {
  practiceItemId String
  techniqueTagId String
  isPrimary      Boolean @default(false)

  practiceItem PracticeItem @relation(fields: [practiceItemId], references: [id])
  techniqueTag TechniqueTag @relation(fields: [techniqueTagId], references: [id])

  @@id([practiceItemId, techniqueTagId])
}

model PracticePerformance {
  id                   String   @id @default(cuid())
  userId               String
  practiceItemId       String
  name                 String? // 表示名 (例: "Performance #3")。null = 旧データ
  audioPath            String
  comparisonResultPath String?
  performanceDuration  Float?
  uploadedAt           DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceItem PracticeItem @relation(fields: [practiceItemId], references: [id], onDelete: Cascade)

  // ▼ 解析結果サマリー（段階3: ハイブリッド方式）
  pitchAccuracy   Float?
  timingAccuracy  Float?
  overallScore    Float?
  evaluatedNotes  Int?
  analysisSummary Json?

  // ▼ v1.3 上達ループエンジン拡張 (R1 = B: pitch/rhythm/bowing 体系)
  // timingAccuracy は Phase 2 で rhythmAccuracy にリネーム予定 (案 Y)。
  rhythmAccuracy Float?
  bowingAccuracy Float?

  // ▼ 非同期ジョブライフサイクル（Cloud Run Jobs）
  analysisStatus  JobStatus @default(done)
  retryCount      Int       @default(0)
  errorMessage    String?
  lastAttemptedAt DateTime?
  executionId     String?
  idempotencyKey  String?   @unique

  // ▼ v3.2.2 上達ループエンジン (Commit 1、score_full の出力を保存)
  pitchSkillScore      Float?
  rhythmSkillScore     Float?
  bowingSkillScore     Float? // Q5: 弦移動なし曲では null
  skillSubScores       Json? // 9 sub task の結果 (各 score, target_count, matched 等)
  problematicPositions Json? // 「気になる箇所」配列 (発見 A: score_full では未生成、別 commit で対応)

  // ▼ v3.2.2 back-reference
  skillFeedbacks PerformanceSkillFeedback[]

  @@index([userId, practiceItemId, uploadedAt])
  @@index([practiceItemId])
}

model UserWeakness {
  id             String   @id @default(cuid())
  userId         String
  weaknessType   String
  weaknessKey    String
  techniqueTagId String?
  severity       Float
  sampleCount    Int
  lastUpdated    DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  techniqueTag TechniqueTag? @relation(fields: [techniqueTagId], references: [id])

  @@unique([userId, weaknessType, weaknessKey])
  @@index([userId, severity])
}

// =============================================
// ▼ S-1: フィードバック・お問い合わせ
// =============================================

model Feedback {
  id           String    @id @default(cuid())
  userId       String? // 退会時 SetNull で匿名化保持
  rating       Int // 1-5
  category     String
  message      String    @db.Text
  contactEmail String?
  createdAt    DateTime  @default(now())
  emailSentAt  DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model SupportInquiry {
  id          String    @id @default(cuid())
  userId      String? // 退会時 SetNull で匿名化保持
  category    String
  subject     String
  message     String    @db.Text
  replyTo     String
  status      String    @default("open") // open | replied | closed
  createdAt   DateTime  @default(now())
  emailSentAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([status])
}

// =============================================
// v3.2.2 上達ループエンジン (Commit 1)
// 設計書 v3.2.2 §4 に基づく
// JobStatus enum は既存温存 (m1 確定)
// =============================================

enum CardType {
  task // 中項目カード (pitch / rhythm / bowing)
  sub_task // 小項目カード (pitch_overall 等)
}

enum CardStatus {
  active // 「気になる箇所」(直近で課題として検出)
  improving // 「改善傾向」(直近3回中 matched=true 1回以下)
  cleared // 「達成」(ユーザーが手動でクリア、C5 確定)
}

enum GradeLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MASTER
}

// v1.3 B-2: 中項目 (pitch/rhythm/bowing) を enum 化 (大文字スネーク、Postgres 正書)
// 既存 GradeLevel が UPPER_SNAKE スタイルのため統一
enum TaskCategory {
  PITCH
  RHYTHM
  BOWING
}

// v1.3 B-2: アサイン教材カテゴリ (scale/arpeggio/etude) を enum 化
// 既存 PracticeCategory (lower_snake) があるが、v1.3 新規モデル用は UPPER_SNAKE で統一
enum AssignedCategory {
  SCALE
  ARPEGGIO
  ETUDE
  // 2026-05-31 練習メニュー再編: 基礎練の新カテゴリ追加
  FINGERING
  BOWING
  POSITION_SHIFT
  DOUBLE_STOP
}

// 中項目スコア累積 (pitch / rhythm / bowing 各 1 行 / user)
// C2: sampleCount に統一 (totalCount ではない)
model UserSkillScore {
  id            String   @id @default(cuid())
  userId        String
  skillTaskId   String // "pitch" | "rhythm" | "bowing"
  currentScore  Float    @default(0) // 0〜100、指数移動平均で更新
  sampleCount   Int      @default(0) // 累積サンプル数
  lastUpdatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillTaskId])
  @@index([userId, skillTaskId])
}

// 小項目スコア累積 (9 sub task 各 1 行 / user)
// C1: matchedCount/totalCount/matchRate/averageScore/lastMatchedAt 5 列
model UserSkillSubScore {
  id             String    @id @default(cuid())
  userId         String
  skillSubTaskId String // 9 sub task の ID (例: "pitch_overall", "string_change_volume")
  matchedCount   Int       @default(0) // 現行C-5: ミス音数の累計 (旧: matched=true回数)。diagnosis_store.py:8 と一致
  totalCount     Int       @default(0) // この sub task が判定対象になった回数 (Q5: target_count > 0 のみ)
  matchRate      Float     @default(0) // ミス率 = matchedCount(=ミス数) / totalCount (課題ランキング・レコメンド用)
  averageScore   Float? // 該当時のスコア平均
  lastMatchedAt  DateTime?
  lastUpdatedAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillSubTaskId])
  @@index([userId, matchRate]) // 課題ランキング用
}

// カード方式の課題管理
// C3: skillTaskId / skillSubTaskId 別カラム + improvedAt
// C5: 自動 cleared なし、ユーザー手動操作のみ
model UserSkillTaskCard {
  id             String     @id @default(cuid())
  userId         String
  cardType       CardType
  skillTaskId    String? // cardType="task" のとき設定 ("pitch" | "rhythm" | "bowing")
  skillSubTaskId String? // cardType="sub_task" のとき設定 ("pitch_overall" 等)
  status         CardStatus
  createdAt      DateTime   @default(now())
  improvedAt     DateTime? // improving に遷移した日時
  clearedAt      DateTime? // cleared に遷移した日時 (C5: ユーザー手動クリア時のみ)
  lastMatchedAt  DateTime? // 直近 matched=true 日時 (中13: マイページ表示用)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardType, skillTaskId, skillSubTaskId])
  @@index([userId, status])
}

// グレード制度 (4 段階、永久保持)
// m4: progressData は JSON キャッシュ、オンデマンド更新
model UserGrade {
  id            String     @id @default(cuid())
  userId        String     @unique
  currentGrade  GradeLevel @default(BEGINNER)
  achievedAt    DateTime? // currentGrade に到達した日時
  progressData  Json       @default("{}") // 難易度別の達成済み PracticeItem ID 集合
  lastUpdatedAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 演奏完了画面のフィードバック保存
// C4: ユーザー操作の保存 (生成テキストキャッシュではない、A 案採用)
// MVP では記録のみ、β で自動学習ループの種にする
//
// v1.3 (2026-05-10): PracticePerformance / Performance (Score 演奏) 両方に対応するため
// polymorphic 化。実装制約: practicePerformanceId と performanceId のうち
// 正確に 1 つだけが非 NULL (Postgres CHECK 制約を migration で raw SQL 追加)。
model PerformanceSkillFeedback {
  id                    String   @id @default(cuid())
  practicePerformanceId String? // PracticePerformance 由来の feedback (排他)
  performanceId         String? // v1.3 新規: Score 演奏 (Performance) 由来の feedback (排他)
  userId                String
  positionId            String // problematicPositions の position_id
  selectedSubTaskId     String? // user_selected の場合に設定 (どの sub task が原因か)
  feedbackType          String // "user_selected" | "user_rejected" | "user_uncertain"
  comment               String? // MVP では使わない、β で自由記述用
  createdAt             DateTime @default(now())

  practicePerformance PracticePerformance? @relation(fields: [practicePerformanceId], references: [id], onDelete: Cascade)
  performance         Performance?         @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([practicePerformanceId])
  @@index([performanceId])
  @@index([userId, feedbackType])
}

// =============================================
// v1.3 上達ループエンジン拡張 (2026-05-10)
// 設計書 v1.3 §6-2 に基づく 9 新規テーブル
// R3 = C ハイブリッド: 既存 UserSkillTaskCard / UserSkillScore / UserSkillSubScore は併存
// (Phase 4-5 で整理)
// =============================================

// ─── (1) SongMastery: 曲ごとのユーザー演奏マスター状態 ───
// v1.3 §2-2 §2-6 / §6-2 (1)
// 演奏マスター: 直近 5 回平均 overallScore ≥ 90 かつ累計 ≥ 5
// 完全習得: 演奏マスター + 全演奏技法習得 + 全中課題クリア
model SongMastery {
  id                    String    @id @default(cuid())
  userId                String
  scoreId               String
  recentAverageScore    Float? // 直近 5 回 overallScore 平均
  totalPerformanceCount Int       @default(0)
  isPerformanceMastered Boolean   @default(false)
  isFullyMastered       Boolean   @default(false)
  performanceMasteredAt DateTime?
  fullyMasteredAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  score Score @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@unique([userId, scoreId])
  @@index([userId, isFullyMastered])
  @@index([scoreId])
}

// ─── (2) UserGradeProgress: ユーザーの現在★+グレード進捗 ───
// v1.3 §1-2 / §6-2 (2)
// 既存 UserGrade とは別概念で併存 (R3 = C):
//   - UserGrade: 旧設計 (currentGrade, progressData JSON)
//   - UserGradeProgress: v1.3 新設計 (currentStar 1-10 + masteredSongCountAtCurrentStar)
model UserGradeProgress {
  id                             String     @id @default(cuid())
  userId                         String     @unique
  currentStar                    Int        @default(1) // 1-10
  currentGrade                   GradeLevel @default(BEGINNER) // B-1: 既存 GradeLevel enum を再利用
  masteredSongCountAtCurrentStar Int        @default(0) // 同★で何曲習得したか (10 で次の★に昇格)
  masterReachedAt                DateTime? // ★10 (master) 到達日時
  updatedAt                      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentStar])
}

// ─── (3) SkillTaskCard: 曲×中項目の課題カード (v1.3 R3 = C) ───
// v1.3 §3-3 / §6-2 (3)
// 既存 UserSkillTaskCard とは別物:
//   - 既存: (userId, sub_task) で 9 カード
//   - v1.3: (userId, scoreId, taskCategory) で曲ごとに最大 3 カード
// taskCategory ∈ { pitch, rhythm, bowing } (R1 = B)
model SkillTaskCard {
  id            String       @id @default(cuid())
  userId        String
  scoreId       String
  taskCategory  TaskCategory // B-2: enum 化 (PITCH | RHYTHM | BOWING)
  status        String       @default("active") // "active" | "improving" | "cleared"
  generatedAt   DateTime     @default(now())
  lastMatchedAt DateTime?
  clearedAt     DateTime?
  updatedAt     DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score    Score     @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  subTasks SubTask[]

  @@unique([userId, scoreId, taskCategory])
  @@index([userId, status])
  @@index([scoreId])
}

// ─── (4) SubTask: 中課題カードに紐づく 9 種類の小課題 ───
// v1.3 §6-2 (4)
// subTaskType: 既存 SUB_TASK_IDS の 9 値 (S1 = A 暫定):
//   pitch_overall, pitch_high, pitch_chromatic
//   rhythm_overall, rhythm_fast, rhythm_after_rest
//   string_change_volume, string_change_slur, string_change_timing
model SubTask {
  id              String    @id @default(cuid())
  skillTaskCardId String
  subTaskType     String
  status          String    @default("active") // "active" | "cleared"
  generatedAt     DateTime  @default(now())
  clearedAt       DateTime?
  updatedAt       DateTime  @updatedAt

  skillTaskCard      SkillTaskCard       @relation(fields: [skillTaskCardId], references: [id], onDelete: Cascade)
  subTaskAssignments SubTaskAssignment[]

  @@unique([skillTaskCardId, subTaskType])
  @@index([subTaskType])
}

// ─── (5) SubTaskAssignment: 小課題に自動アサインされた教材 (3 カテゴリ × 1) ───
// v1.3 §2-4 §3-4 / §6-2 (5)
// M6 = B: 1 SubTask に対し scale + arpeggio + etude の 3 件作成
model SubTaskAssignment {
  id               String           @id @default(cuid())
  subTaskId        String
  practiceItemId   String
  assignedCategory AssignedCategory // B-2: enum 化 (SCALE | ARPEGGIO | ETUDE)
  isMastered       Boolean          @default(false)
  masteredAt       DateTime?
  assignedAt       DateTime         @default(now())

  subTask      SubTask      @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  practiceItem PracticeItem @relation(fields: [practiceItemId], references: [id], onDelete: Cascade)

  @@unique([subTaskId, practiceItemId])
  @@index([subTaskId])
  @@index([practiceItemId])
}

// ─── (6) UserPracticeMastery: PracticeItem ごとのユーザー演奏マスター状態 ───
// v1.3 §2-2 / §6-2 (6)
// Phase 3c 追加仕様 (2026-05-16, Tetsuo 確定): 演奏マスター必要回数を 5 回統一に変更
// 演奏マスター: 直近 5 回平均 overallScore ≥ 90 かつ累計 ≥ 5
// (Q1=B 永続: 一度 mastered になったら以降の再計算で false に戻さない、masteredAt 固定)
model UserPracticeMastery {
  id                    String    @id @default(cuid())
  userId                String
  practiceItemId        String
  recentAverageScore    Float?
  totalPerformanceCount Int       @default(0)
  isPerformanceMastered Boolean   @default(false)
  masteredAt            DateTime?
  celebratedAt          DateTime? // 祝い体験 v2.0 (2026-07-26): 教材クリアの祝い既読。バナー消滅の根拠
  updatedAt             DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceItem PracticeItem @relation(fields: [practiceItemId], references: [id], onDelete: Cascade)

  @@unique([userId, practiceItemId])
  @@index([userId, isPerformanceMastered])
}

// ─── (7) UserTechniqueMastery: 演奏技法ごとのユーザー習得状態 ───
// v1.3 §2-3 / §6-2 (7)
// 習得: 同調・同★・同 T を持つ scale + arpeggio + etude のうち、
//       実在する全カテゴリで 1 つ以上演奏マスター
model UserTechniqueMastery {
  id             String    @id @default(cuid())
  userId         String
  techniqueTagId String
  isMastered     Boolean   @default(false)
  masteredAt     DateTime?
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  techniqueTag TechniqueTag @relation(fields: [techniqueTagId], references: [id], onDelete: Cascade)

  @@unique([userId, techniqueTagId])
  @@index([userId, isMastered])
}

// ============================================================================
// 工程D (2026-07-11): 新判定体系（spec§1・達成/マスター/Star/学びレッスン）
// 旧記録テーブル(UserPracticeMastery/UserGrade等)は意味が違うため流用しない。
// 書き手は loop_engine (Python raw SQL)。永続・遡及なし（一度成立したら消さない）。
// ============================================================================

// 学びレッスンのクリア記録（一度きり・永続・難易度非依存 = spec§1-5）
model UserLessonClear {
  id           String   @id @default(cuid())
  userId       String
  tagType      String // "technique" | "position" | "double_stop"
  tagKey       String // TechniqueTag名 / ポジション番号("3") / FeatureTag名("3度"等)
  lessonItemId String? // クリアに使ったlesson教材（教材差替えに耐えるためnull可）
  clearedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tagType, tagKey])
  @@index([userId])
}

// 曲の達成/マスター記録（達成=3回崩壊ゼロ+レッスン+エチュード要件 / マスター=達成+avg90）
model UserScoreAchievement {
  id                    String    @id @default(cuid())
  userId                String
  scoreId               String
  achievedAt            DateTime  @default(now())
  starAtAchievement     Int // 達成時の★（Star昇格「同★10曲」の集計キー）
  masteredAt            DateTime? // 達成後 直近5回平均90成立時に刻む（消さない）
  achievedPerformanceId String? // 達成を確定させた演奏（お祝いUI用）
  // ▼ 祝い体験 v2.0 (2026-07-26)
  masteredPerformanceId String? // マスターに遷移した演奏ID。masteredAt刻印と同時記録。再解析耐性(ID照合)の根拠
  celebratedAt          DateTime? // 祝いカード閲覧で記録。バナー消滅・端末をまたぐ一回性の根拠

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  score Score @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@unique([userId, scoreId])
  @@index([userId, starAtAchievement])
}

// 教材の達成記録（3回崩壊ゼロ。エチュード要件・練習済み除外の判定材料）
model UserPracticeAchievement {
  id             String   @id @default(cuid())
  userId         String
  practiceItemId String
  achievedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceItem PracticeItem @relation(fields: [practiceItemId], references: [id], onDelete: Cascade)

  @@unique([userId, practiceItemId])
  @@index([userId])
}

// ============================================================================
// オンボーディング C5 (2026-07-12): 回答保存・仮習得・曲リクエスト・曲カタログ
// 全ユーザー対象(既存ユーザーも次回ログインで質問を受ける = Tetsuo確定 2026-07-12)。
// ============================================================================

// オンボーディング回答（ドラフト=中断復帰 + 完了記録）。answersはJSONBで保持し、
// 将来の消費(Q5→読譜初期値/Q6→ストリーク目標等)はprofile経由で読む。
model OnboardingProfile {
  userId      String    @id
  answers     Json      @default("{}") // q2〜q8 / goalDate / goalSong
  ladder      Json      @default("{}") // ラダー回答(再判定・監査用)
  screen      String? // 中断復帰用の現在画面
  seg         Json      @default("{}") // プログレスバー状態
  star        Int? // 確定★(ラダー判定結果)
  completedAt DateTime? // 「さっそくスタートする」時刻。非null=オンボ済み
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 仮習得3状態モデル (§27-5): PROVISIONAL(自己申告) → CONFIRMED(初回演奏で検証OK)
//                            / REVOKED(検証NGで剥奪)。
// 工程DのUserLessonClear(レッスン実績)とは別物=自己申告スキル。
// achievement.py 達成要件① は UserLessonClear ∪ UserTagAcquisition(state≠REVOKED)
// で判定する(2026-07-12 拡張済み)。
model UserTagAcquisition {
  id          String    @id @default(cuid())
  userId      String
  tagType     String // "technique" | "position" | "double_stop"
  tagKey      String // "スラー" / "3" (UserLessonClearと同じ裸数字) / "3度"
  state       String    @default("PROVISIONAL") // PROVISIONAL | CONFIRMED | REVOKED
  source      String    @default("onboarding")
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tagType, tagKey])
}

// 学びレッスンの演奏回数 (学びレッスン確定#3 2026-07-14)。
// 解析なし・端末内発音チェック(窓あき)合格の報告を数え、3回で UserLessonClear を書く。
// 録音音声は破棄しアップロードしない。正式なクリア記録は UserLessonClear が正。
model UserLessonPlay {
  id             String   @id @default(cuid())
  userId         String
  practiceItemId String // category=lesson の教材
  playCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceItem PracticeItem @relation(fields: [practiceItemId], references: [id], onDelete: Cascade)

  @@unique([userId, practiceItemId])
}

// 未収録曲リクエスト (§27-8): Q8「憧れの曲」の自由入力。曲追加時通知の元データ。
model SongRequest {
  id        String   @id @default(cuid())
  userId    String
  songName  String
  source    String   @default("onboarding")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([songName])
}

// 曲カタログ (v1.0確定・DB化)。モックJSONはAPI失敗時のフォールバックとして残す。
// scoreId: 目標曲→実際の楽譜(Score)への結線。楽譜アップロード時に名前正規化一致で
// 自動リンク(uploadScore)+一括結線スクリプト(scripts/link-onboarding-songs.ts)。
model OnboardingSong {
  id        String  @id @default(cuid())
  category  String // movie | classic | season
  name      String
  star      Int
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  scoreId   String?

  score Score? @relation(fields: [scoreId], references: [id], onDelete: SetNull)

  @@unique([category, name])
  @@index([scoreId])
}

// Starの現在地（昇格 = UserScoreAchievement の同★件数≥10）
model UserStarProgress {
  userId      String   @id
  currentStar Int      @default(1)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 工程G (2026-07-11): スタッカート系曖昧記号の管理者確認キュー。
// 楽譜の点(・)は記号だけでは奏法を確定できない(§18-2 決定#4)ため、
// analyze_musicxml が「スタッカート仮付与+本キューに記録」し、管理者が
// /admin/confirmations で一律4択(スタッカート/スピッカート/連続スタッカート(旧ボウ・スタッカート)/
// ポルタート)から曲単位一括で確定する(2026-07-11 Tetsuo確定)。
// 確定済み(confirmed)は再解析でも pending に戻さない(件数・小節のみ更新)。
model TechniqueConfirmation {
  id          String    @id @default(cuid())
  targetType  String // "score" | "practice"
  targetId    String // Score.id / PracticeItem.id
  pattern     String // "staccato_inside_slur" | "staccato_outside_slur"
  noteCount   Int       @default(0)
  measures    Int[] // 該当小節番号(表示用)
  status      String    @default("pending") // "pending" | "confirmed"
  resolvedTag String? // 確定した奏法タグ名(選び直し時の付け替え元にも使う)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([targetType, targetId, pattern])
  @@index([status])
}

// ─── (8) PracticeItemSubTaskTag: PracticeItem ⇔ sub_task の多対多 ───
// v1.3 §6-2 (8)
// 既存 PracticeItem.skillSubTaskTags JSON カラムの正規化版
// (両方残して移行は Phase 4 で整理)
model PracticeItemSubTaskTag {
  practiceItemId String
  subTaskType    String

  practiceItem PracticeItem @relation(fields: [practiceItemId], references: [id], onDelete: Cascade)

  @@id([practiceItemId, subTaskType])
  @@index([subTaskType])
}

// ─── (8b) ScoreTechniqueTag: Score ⇔ TechniqueTag の多対多 ───
// v1.3 Phase 3c 追加 (2026-05-16, Tetsuo Q4=B 確定)
// 完全習得判定 (§2-6) で「全演奏技法習得」を判定するために Score 自身に紐づく
// TechniqueTag 集合が必要。admin Score 登録 UI に技法選択 (Phase 4 で実装) →
// このテーブルに保存。PracticeItemTechnique と同じ M2M 構造。
model ScoreTechniqueTag {
  scoreId        String
  techniqueTagId String
  isPrimary      Boolean @default(false)

  score        Score        @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  techniqueTag TechniqueTag @relation(fields: [techniqueTagId], references: [id], onDelete: Cascade)

  @@id([scoreId, techniqueTagId])
  @@index([techniqueTagId])
}

// ─── (9) MissingPracticeItemFlag: 該当教材ゼロ件時の admin 通知フラグ ───
// v1.3 §2-4 / §6-2 (9) / I1 = A 確定
// 1 カテゴリでも該当教材 0 件なら sub_task 自体生成スキップ + このフラグ作成
model MissingPracticeItemFlag {
  id              String    @id @default(cuid())
  scoreId         String
  subTaskType     String
  missingCategory String // "scale" | "arpeggio" | "etude" のうち欠けている
  keyTonic        String
  keyMode         String
  star            Int
  techniqueTagId  String?
  detectedAt      DateTime  @default(now())
  resolvedAt      DateTime? // admin が該当教材登録した日時。null = 未解決

  score        Score         @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  techniqueTag TechniqueTag? @relation(fields: [techniqueTagId], references: [id], onDelete: SetNull)

  @@index([scoreId, resolvedAt])
  @@index([keyTonic, keyMode, star])
  @@index([resolvedAt])
}

// =============================================
// ▼ 工程F: 特徴タグ・副次調 (2026-07-10, 設計書§14/§19/§20)
// =============================================

// 副次調(転調先)。主調は Score.keyTonic/keyMode が正(二重保持しない)。
// 検出は譜面上の調号変更のみ(臨時記号のみの転調はv1対象外 §19-1)。
model ScoreKey {
  id        String @id @default(cuid())
  scoreId   String
  keyTonic  String // 'Bb' 形式 (既存 keyTonic と同じ正規化)
  keyMode   String // 'major' / 'minor'
  sortOrder Int    @default(0) // 転調の出現順

  score Score @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@unique([scoreId, keyTonic, keyMode])
  @@index([keyTonic, keyMode])
}

// 特徴タグ(リスト系)。曲・教材の性質属性。TechniqueTag と同型の M:N。
// 動的拡張(§23)の対象: 管理者がタグ+抽出ルールを追加→全曲再分析。
model FeatureTag {
  id            String   @id @default(cuid())
  category      String // "rhythm" | "double_stop" | "dynamics" | "position"
  name          String
  extractRule   String? // 抽出条件メモ(動的拡張用)
  isAcquisition Boolean  @default(false) // 習得系(達成をゲート)。重音の主要種別=true
  createdAt     DateTime @default(now())

  scoreTags        ScoreFeatureTag[]
  practiceItemTags PracticeItemFeatureTag[]

  @@unique([category, name])
  @@index([category])
}

model ScoreFeatureTag {
  scoreId      String
  featureTagId String

  score      Score      @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  featureTag FeatureTag @relation(fields: [featureTagId], references: [id], onDelete: Cascade)

  @@id([scoreId, featureTagId])
  @@index([featureTagId])
}

model PracticeItemFeatureTag {
  practiceItemId String
  featureTagId   String

  practiceItem PracticeItem @relation(fields: [practiceItemId], references: [id], onDelete: Cascade)
  featureTag   FeatureTag   @relation(fields: [featureTagId], references: [id], onDelete: Cascade)

  @@id([practiceItemId, featureTagId])
  @@index([featureTagId])
}

// ▼ 先生ユーザー機能 MVP (2026-07-28 Tetsuo)。別シェル /teacher。将来の予約/添削/決済等は
// この2モデルの拡張 or 関連テーブル追加で足す(画面はタブ/カード/セクション追加)。
// 先生⇄生徒の紐付け。多対多(将来: 1先生:多生徒 / 1生徒:多先生)。招待コードは User.teacherInviteCode。
model TeacherStudent {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  createdAt DateTime @default(now())

  teacher User @relation("teacherLinks", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("studentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@index([studentId])
}

// 宿題 (ch5-3)。先生が「曲 or 教材・対象小節・回数・目標テンポ・コメント」を割当。
// 生徒ホームに出て既存の練習ループへ着地する。将来: 提出/添削は関連テーブルで拡張。
model Assignment {
  id             String    @id @default(cuid())
  teacherId      String
  studentId      String
  scoreId        String? // 対象が曲のとき
  practiceItemId String? // 対象が教材のとき
  targetMeasures String? // "1-4" 等、対象小節(自由入力)
  reps           Int? // 練習回数
  targetTempo    Int? // 目標テンポ(BPM)
  comment        String? // 生徒へのコメント
  doneAt         DateTime? // 生徒が完了にした時刻(任意)
  // ▼ 提出 (2026-07-29 Phase1.5): 生徒が録音を紐付けて提出。先生に点数ごと届く。
  submittedAt           DateTime? // 提出時刻
  submittedPerformanceId String? // 提出した演奏ID(Performance or PracticePerformance・ゆるい参照)
  submittedScore        Float? // 提出時の点数(音程×リズム平均)
  createdAt      DateTime  @default(now())

  teacher      User          @relation("assignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student      User          @relation("assignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  score        Score?        @relation(fields: [scoreId], references: [id], onDelete: SetNull)
  practiceItem PracticeItem? @relation(fields: [practiceItemId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
}

// 先生⇔生徒の短文メッセージ (2026-07-28 Phase1.5)。fromTeacher で向きを表す。
model Message {
  id          String    @id @default(cuid())
  teacherId   String
  studentId   String
  fromTeacher Boolean // true=先生→生徒 / false=生徒→先生(質問)
  body        String
  readAt      DateTime? // 受け手が読んだ時刻
  createdAt   DateTime  @default(now())

  teacher User @relation("msgTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("msgStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherId, studentId, createdAt])
  @@index([studentId, createdAt])
}

// 添削 (2026-07-29 Phase1.5-c)。先生が「特定の生徒の曲/教材」に書き込む譜面注釈。
// data は ScoreAnnotation と同形式(highlight/warnings/notation・音符アンカー)で描画を流用。
model TeacherFeedback {
  id             String   @id @default(cuid())
  teacherId      String
  studentId      String
  scoreId        String?
  practiceItemId String?
  data           Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacher User @relation("fbTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("fbStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId, scoreId])
  @@unique([teacherId, studentId, practiceItemId])
  @@index([studentId])
}

// 先生プロフィール (2026-08-01 Phase2)。先生が自分で編集。「先生を探す」ページに掲載。
model TeacherProfile {
  id          String   @id @default(cuid())
  teacherId   String   @unique
  headline    String? // 一言(例: 移弦とリズムが得意)
  bio         String? // 自己紹介
  specialties String[] // 得意タグ(例: 移弦/リズム/初心者/ビブラート)
  levels      String[] // 対応レベル(初級/中級/上級)
  forKids     Boolean  @default(false) // 子どもOK
  online      Boolean  @default(true) // オンライン対応
  priceNote   String? // 料金(自由テキスト)
  trial       Boolean  @default(false) // 体験レッスン可
  sampleUrl   String? // 演奏サンプル/動画URL
  published   Boolean  @default(false) // 「先生を探す」に掲載する
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher User @relation("profileTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([published])
}

// ▼ お気に入り (2026-07-20 Tetsuo): 曲(Score) or 教材(PracticeItem) をユーザーがブックマーク。
// 片方のみ非NULL。Postgres は NULL を distinct 扱いするため、2本の複合ユニークは共存可
// (score お気に入りは practiceItemId=NULL が複数、practiceItem お気に入りは scoreId=NULL が複数)。
model Favorite {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scoreId        String?
  score          Score?        @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  practiceItemId String?
  practiceItem   PracticeItem? @relation(fields: [practiceItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([userId, scoreId])
  @@unique([userId, practiceItemId])
  @@index([userId])
}
